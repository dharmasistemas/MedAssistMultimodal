# Não versionar .env. O baseline funciona offline sem este arquivo.
AZURE_STATUS=PENDENTE_FIAP
RUN_AZURE_INTEGRATION=0
LLM_ENABLED=0
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=0.5
LLM_RETRY_BACKOFF=2.0
RUN_OLLAMA_INTEGRATION=0
SQLITE_PATH=data/interim/medassistmultimodal.sqlite3

# Contingência Azure: preencher somente no .env local; não enviar chaves pelo chat.
# F0 declarado aqui NÃO confirma SKU, elegibilidade nem assinatura no portal.
AUDIO_PROVIDER=mock
AZURE_STUDENTS_STATUS=INDISPONIVEL
AZURE_ACCOUNT_STATUS=MICROSOFT_SEM_ASSINATURA
AZURE_SUBSCRIPTION_CONFIRMED=0
AZURE_SPEECH_F0_CONFIRMED=0
AZURE_LANGUAGE_F0_CONFIRMED=0
AZURE_SPEECH_TIER=F0
AZURE_LANGUAGE_TIER=F0
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
